# Copy this file to `.env` when local environment variables are introduced.
#
# Use only safe placeholder values in this template. Never commit secrets,
# private keys, access tokens, or real credentials.
#
# Add each variable here alongside the application code that consumes it.

# Blockchain adapter: MOCK or ETHEREUM
DEX_BLOCKCHAIN_MODE=MOCK
DEX_DEPLOYMENT_ID=local-mock-v1

# Required only in Ethereum mode
DEX_RPC_URL=
DEX_EXPECTED_CHAIN_ID=
DEX_CONTRACT_ADDRESS=
DEX_MARKET_REGISTRY_ADDRESS=
DEX_DEPLOYMENT_BLOCK=
DEX_EXECUTOR_PRIVATE_KEY=
DEX_EXECUTOR_POLL_INTERVAL=2s

# Indexer and matcher
DEX_INDEXER_ENABLED=true
DEX_INDEXER_POLL_INTERVAL=2s
DEX_INDEXER_CONFIRMATION_DEPTH=0
DEX_INDEXER_BLOCK_BATCH_SIZE=500
DEX_MATCHER_ENABLED=false
DEX_MATCHER_POLL_INTERVAL=2s
DEX_MATCHER_INELIGIBILITY_DURATION=30s

# Comma-separated frontend origins
DEX_CORS_ORIGINS=http://localhost:5173

DATABASE_NAME=
DATABASE_PORT=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
