{
  "name": "Documents",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.10 <25"
  },
  "scripts": {
    "compile": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test mocha",
    "test:solidity": "hardhat test solidity",
    "verify": "npm run compile && npm run typecheck && npm test",
    "node:local": "hardhat node --hostname 127.0.0.1 --port 8545",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "verify:e2e-state": "hardhat run scripts/verify-e2e-state.ts --network localhost",
    "e2e:backend": "bash scripts/backend-e2e.sh"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
